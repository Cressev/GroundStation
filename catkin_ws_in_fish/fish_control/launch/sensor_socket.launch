<?xml version="1.0"?>
<!--
  传感器数据Socket服务器启动文件
  Sensor Data Socket Server Launch File
  
  创建时间: 2026-01-28
  说明: 启动所有传感器节点和Socket服务器，用于与地面站通信
  
  使用方法:
    roslaunch fish_control sensor_socket.launch
  
  参数:
    server_port: Socket服务器端口，默认9999
    data_rate: 数据推送频率(Hz)，默认50
-->
<launch>
    <!-- 参数 -->
    <arg name="server_port" default="9999"/>
    <arg name="data_rate" default="50"/>
    
    <!-- IMU发布节点 -->
    <node pkg="TransducerM_pkg" type="TMSerial" name="imu_pub" output="screen"/>
    
    <!-- UWB发布节点 -->
    <include file="$(find nlink_parser)/launch/linktrack.launch"/>
    
    <!-- 深度传感器发布节点 (需要sudo权限) -->
    <!-- calib参数说明：
         - true: 校准模式，校准完成后自动关闭程序
         - false: 正常发布深度信息到/WF5803_topic话题 -->
    <node pkg="fish_control" type="WF5803_pub_node.py" name="WF5803_pub_node" output="screen">
        <param name = "calib" value="false"/>
    </node>    
    
    <!-- Socket服务器节点 -->
    <node pkg="fish_control" type="socket_server.py" name="fish_socket_server" output="screen">
        <param name="server_port" value="$(arg server_port)"/>
        <param name="data_rate" value="$(arg data_rate)"/>
    </node>

    <!-- 舵机控制节点 - 订阅控制命令 -->
    <param name="tail_frequency" value="0.0"/>
    <param name="tail_bias" value="0.0"/>
    <param name="tail_A" value="0.0"/>
    <param name="pec_angle" value="1500"/>
    <node pkg="fish_control" name="controller" type="servo_control" output="screen">
        <param name="servo_time" value="200000"/>  <!-- 运行时间s，足够长 -->
        <param name="wait_imu_calib" value="false"/>
    </node>

    <!-- 机器鱼鱼眼摄像头视频流服务 -->
    <node pkg="fish_control" type="camera_stream_server.py" 
          name="camera_stream_server" output="screen">
        <!-- 服务器端口 -->
        <param name="port" value="9998"/>
        <!-- 摄像头索引 (0为第一个摄像头) -->
        <param name="camera" value="0"/>
        <!-- 视频分辨率 -->
        <param name="width" value="640"/>
        <param name="height" value="480"/>
        <!-- 目标帧率 -->
        <param name="fps" value="20"/>
        <!-- JPEG质量 (1-100) -->
        <param name="quality" value="80"/>
    </node>

    <!-- 全局运行时间控制 -->
    <node pkg="fish_control" type="timer_controller.py" name="timer_controller" output="screen">
        <param name="duration" value="25000"/>  <!--运行时间秒-->
    </node>

</launch>
